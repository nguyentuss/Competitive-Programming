{
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/include"
    ],
    "C_Cpp.default.compilerPath": "/usr/bin/clang++",
    "C_Cpp.default.cppStandard": "gnu++17",
    "code-runner.executorMap": {
        "cpp": "cd $dir && clang++ -std=c++17 -I\"${workspaceFolder}/include\" $fileName -o $fileNameWithoutExt && $dir$fileNameWithoutExt"
    },
    "files.associations": {
        "tuple": "cpp",
        "iostream": "cpp",
        "iosfwd": "cpp",
        "chrono": "cpp",
        "vector": "cpp",
        "*.tcc": "cpp",
        "deque": "cpp",
        "list": "cpp",
        "string": "cpp",
        "unordered_map": "cpp",
        "unordered_set": "cpp",
        "forward_list": "cpp",
        "rope": "cpp",
        "slist": "cpp",
        "barrier": "cpp",
        "random": "cpp",
        "latch": "cpp",
        "limits": "cpp",
        "semaphore": "cpp",
        "valarray": "cpp",
        "stdc++.h": "cpp"
    },
    "cph.language.cpp.Args": "-std=c++17 -I/opt/homebrew/include -I${workspaceFolder}/include"
}